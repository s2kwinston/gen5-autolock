# gen5-autolock configuration (example)
#
# Copy this to  gen5-autolock.conf  next to walkaway.sh to override the built-in
# defaults WITHOUT editing the script (so an update won't clobber your settings):
#
#     cp gen5-autolock.conf.example gen5-autolock.conf
#
# Format: one KEY=value per line; '#' comments on their own line. The daemon
# PARSES only the known keys below and never executes this file, so it can't run
# code even as root. Out-of-range or non-numeric values are ignored and the
# built-in default is used instead. Uncomment a line to change it.

# -- the main one: how long after the last door closes before it locks (seconds)
# LOCK_DELAY=30          # allowed 5–600; keep it short (≤ ~90). The head unit only stays
#                        # awake ~3 min from when you open the driver door to get out, and
#                        # a door held open while you unload uses that time up. Counted in
#                        # real seconds.

# -- turn the feature off without stopping the daemon (also: touch the off-file,
#    /data/nemesis/gen5-autolock.off, to pause and delete it to resume)
# ENABLED=1              # 0 = installed but inactive

# -- send real locks. The installer you chose seeds this (standard = 0 LIVE,
#    test-mode = 1); the GO LIVE / TEST MODE sticks flip it. With no value at all
#    the daemon's built-in default is 1 (never locks).
# DRY_RUN=1              # 1 = log only, 0 = actually lock

# -- arm on the driver door only (1) or any door (0, more false arming)
# DRIVER_DOOR_ONLY=1

# -- poll/timing (rarely need changing)
# POLL_ACTIVE=1          # poll interval after ignition off (s), 1–10
# POLL_DRIVE=5           # poll interval while driving/idle (s), 1–30
# POST_FIRE_CONFIRM=5    # seconds to confirm the lock took, 1–30
# MAX_FIRES=3            # lock attempts per stop before giving up, 1–10
# MIN_ACC=3              # ACC state to fire at (off-standby), 0–5

# -- framework hash gate: 1 = run only on a verified build (md5 built in) or one you
#    pinned with the ref-odex stick; 0 = skip the check (not recommended)
# CHECK_ODEX=1

# -- hood/frunk guard: 1 = don't lock while the hood is open (read from the system
#    log; verified on the 2022 US EV6). 0 = ignore the hood (if your firmware's log
#    has no "mHoodSwitchState" line, the daemon treats the hood as closed anyway).
# HOOD_GUARD=1

# -- KEY SENSOR (optional key-inside protection; needs the ESP32 BLE key sensor on the
#    head unit's USB port — see docs/key-sensor.md). Off by default: nothing below
#    matters then. The key-sensor installer switches KEY_GATE on for you.
# KEY_GATE=0             # 1 = lock only after the key tag was heard at the exit and has
#                        #     then been quiet for KEY_GONE_DEBOUNCE (it LEFT). Still heard,
#                        #     never heard, or sensor offline = no lock.
# KEY_GONE_DEBOUNCE=20   # s of silence the sensor must OBSERVE before "the key left", 10–600.
#                        #     Longest gap seen with the key in the car: 7.5 s. Much longer
#                        #     and the head unit can fall asleep before it locks.
# FLASH_DELAY=60         # s after the exit before the "key left inside" hazard flash, 10–600
# HAZARD_LIVE=0          # leave 0 (log only): the hazard flash is untested on a car, and it
#                        #     can't yet tell "key inside" from "you standing next to the car"
# HAZARD_SECS=3          # s the hazards run before the stop command, 1–15
# KEY_HOLD_MAX=180       # s after the exit to keep waiting for the key to leave, 60–1800
# KEY_STALE=10           # s without a sensor line before it counts as offline, 3–120
# KEY_BOOT_GRACE=60      # s after start before an offline/tag warning toast, 10–600
# KEY_READY_TOAST=1      # 0 = no "key sensor ready" toast
