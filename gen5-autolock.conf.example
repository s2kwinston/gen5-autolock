# gen5-autolock configuration (example)
#
# Copy this to  gen5-autolock.conf  next to walkaway.sh to override the built-in
# defaults WITHOUT editing the script (so an update won't clobber your settings):
#
#     cp gen5-autolock.conf.example gen5-autolock.conf
#
# Format: one KEY=value per line; '#' comments on their own line. The daemon
# PARSES only the known keys below and never executes this file, so it can't run
# code even as root. Out-of-range or non-numeric values are ignored and the
# built-in default is used instead. Uncomment a line to change it.

# -- the main one: how long after the last door closes before it locks (seconds)
# LOCK_DELAY=30          # allowed 5–600

# -- turn the feature off without stopping the daemon (also: touch the off-file,
#    /data/nemesis/gen5-autolock.off, to pause and delete it to resume)
# ENABLED=1              # 0 = installed but inactive

# -- send real locks. KEEP THIS 0 (dry-run) until you've watched the log over
#    several real drives and it only ever "WOULD FIRE" on a genuine park-and-exit.
# DRY_RUN=1              # 1 = log only, 0 = actually lock

# -- arm on the driver door only (1) or any door (0, more false arming)
# DRIVER_DOOR_ONLY=1

# -- poll/timing (rarely need changing)
# POLL_ACTIVE=1          # poll interval after ignition off (s), 1–10
# POLL_DRIVE=5           # poll interval while driving/idle (s), 1–30
# POST_FIRE_CONFIRM=5    # seconds to confirm the lock took, 1–30
# MAX_FIRES=3            # lock attempts per stop before giving up, 1–10
# MIN_ACC=3              # ACC state to fire at (off-standby), 0–5

# -- framework hash gate: 1 = refuse to run if /system/framework changed
# CHECK_ODEX=1
